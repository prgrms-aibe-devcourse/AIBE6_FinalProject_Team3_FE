NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your_kakao_javascript_key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_USE_MOCK_DATA=true
# 랜딩 페이지(/) 맨 아래 "개발자용 관리자 로그인" 버튼 노출 여부. 백엔드 DEV_LOGIN_ENABLED와
# 짝을 맞춰야 하며, 운영 배포에서는 반드시 false(또는 미설정)로 둘 것.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
# 프론트(Vercel 등)와 백엔드(EC2 등)가 등록 도메인을 전혀 공유하지 않는 배포에서만 true로 설정.
# 로컬/서브도메인 공유 배포에서는 false(또는 미설정) — app/config/auth.ts 참고.
NEXT_PUBLIC_CROSS_ORIGIN_AUTH=false
