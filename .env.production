# Next.js는 `next build`/`next start`에서 .env.production을 읽지만, .env.local이 존재하면
# 그쪽이 항상 더 높은 우선순위로 이 파일의 값을 덮어쓴다(dev든 build든 동일 - 프레임워크 설계상
# .env.local은 "이 머신의 개인 오버라이드"를 의미해 항상 이긴다). Vercel의 Git 연동 빌드는
# 저장소를 새로 체크아웃해서 빌드하므로 .env.local(gitignore 대상)이 없어 이 파일이 정상 적용
# 되지만, 이 로컬 작업 폴더에서 직접 `next build`를 돌리면(.env.local이 남아있는 채로) 조용히
# localhost:8080이 그대로 박힌 빌드가 나온다 - 실제 배포 방식이 Vercel Git 연동이 아니라면 반드시
# 확인할 것.
# 백엔드(EC2) IP가 고정되어 여기 커밋한다 - 시크릿이 아니라 공개 API 엔드포인트 주소이므로
# .env.local과 달리 git에 포함해도 안전하다.
NEXT_PUBLIC_API_BASE_URL=https://54.116.65.225

# 프론트(Vercel)/백엔드(EC2)가 등록 도메인을 공유하지 않는 시나리오 C로 배포 확정됨
# (docs/specs/★2026-08-04-cross-origin-auth-deployment-decision.md 참고) - 이 값이 없으면
# proxy.ts/MainLayoutGate가 크로스오리진 인증 경로를 타지 않아 로그인 게이트가 깨진다.
NEXT_PUBLIC_CROSS_ORIGIN_AUTH=true
